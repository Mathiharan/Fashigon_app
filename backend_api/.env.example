# Copy this file to .env in the same folder (backend_api/.env).
# Never commit .env.

# MongoDB Atlas connection string (Database Access user + Network Access 0.0.0.0/0 or your host IPs)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Long random string for JWT signing (same value used for sign + verify)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional; default 3000
PORT=3000
